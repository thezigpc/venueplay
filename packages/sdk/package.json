{
  "name": "@bargames/sdk",
  "version": "0.12.0",
  "description": "Game SDK for the Bar Games platform: venue branding, events, commands and the bargames.json manifest.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./integration": { "types": "./dist/integration.d.ts", "default": "./dist/integration.js" },
    "./package.json": "./package.json"
  },
  "bin": { "bargames": "./dist/cli.js" },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  }
}
