# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 32
BROKER_TOKEN=
GATEWAY_TOKEN=
SESSION_SECRET=

# Cloudflare: set up from the admin UI's Internet tab (no token needed here).

# Display drivers: roku, mock. MOCK_DISPLAYS adds virtual TVs for testing.
DRIVERS=roku
MOCK_DISPLAYS=0

# `getent group render | cut -d: -f3` on the box
RENDER_GID=991

LOG_LEVEL=info
