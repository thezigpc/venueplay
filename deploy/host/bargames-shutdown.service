# Removes the request first (so the box doesn't switch off again at the next boot), then powers off.
[Unit]
Description=Bar Games shutdown (requested from the admin)

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'logger -t bargames "shutdown requested from the admin: $(cat @DATA@/shutdown.request 2>/dev/null)"; rm -f @DATA@/shutdown.request; sync; /usr/bin/systemctl poweroff'
